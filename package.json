{
  "name": "game-library-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "esbuild src/client/admin.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/assets/admin.js",
    "predev": "node scripts/backup-kv.ts",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev -e remote",
    "kv:push": "node scripts/sync-kv.ts push",
    "kv:pull": "node scripts/sync-kv.ts pull",
    "kv:restore": "node scripts/restore-kv.ts",
    "publish:games": "node scripts/publish-games.ts",
    "refresh:game-meta": "node scripts/refresh-game-meta.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json && tsc -p scripts/tsconfig.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "devalue": "^6.0.2",
    "hono": "^4.13.10",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.142.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
