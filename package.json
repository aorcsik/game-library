{
  "name": "game-library-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-fontawesome.mjs && esbuild src/client/admin.ts --bundle --format=esm --target=es2022 --sourcemap --outfile=public/assets/admin.js",
    "postinstall": "node scripts/build-fontawesome.mjs",
    "update:rates": "node --experimental-strip-types scripts/update-exchange-rates.ts",
    "migrate:transaction-references": "node --experimental-strip-types scripts/migrate-transaction-references.ts",
    "predev": "node scripts/backup-kv.ts",
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev -e remote",
    "kv:push": "node scripts/sync-kv.ts push",
    "kv:pull": "node scripts/sync-kv.ts pull",
    "kv:restore": "node scripts/restore-kv.ts",
    "publish:games": "node scripts/publish-games.ts",
    "refresh:game-meta": "node scripts/refresh-game-meta.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/client/tsconfig.json && tsc -p scripts/tsconfig.json",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fortawesome/fontawesome-pro": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/pro-regular-svg-icons": "^7.3.1",
    "@fortawesome/pro-solid-svg-icons": "^7.3.1",
    "devalue": "^6.0.2",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "json5": "^2.2.3",
    "miniflare": "5.20261006.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.148.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261006.1": true
  }
}
