ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Keep this local-only marker in .dev.vars to disable authentication locally.
LOCAL_DEV=on
# Local-only metadata fetcher (scraping endpoints + /refresh page). Never set in production.
FETCHER=on
# Steam wishlist sync (Steam Web API key and 64-bit Steam ID; the profile's game details must be public).
STEAM_API_KEY=
STEAM_ID=
